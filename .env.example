# Site
NEXT_PUBLIC_SITE_URL=https://gjh-inc.com

# Assistant (Wave 2) — server-side only, never expose
ANTHROPIC_API_KEY=

# Contact form delivery (Wave 2)
RESEND_API_KEY=
CONTACT_TO_EMAIL=consult@gjh-inc.com

# Analytics (Wave 2) — privacy-first, no cookie banner required
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=gjh-inc.com

# X platform — read test. Fill in .env (gitignored), never commit values.
# Bearer Token = read-only public data. Posting needs OAuth 1.0a / 2.0.
X_BEARER_TOKEN=
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
